    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFV8N45/1/"/>
    <ns1:version>1</ns1:version>
    <skos:definition xml:lang="en">Mole fraction is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y.  The chemical formula of peroxynitric acid is HNO4.</skos:definition>
    <dc:identifier>SDN:P07::CFV8N45</dc:identifier>
    <skos:prefLabel xml:lang="en">mole_fraction_of_peroxynitric_acid_in_air</skos:prefLabel>
    <owl:versionInfo>1</owl:versionInfo>
    <skos:altLabel></skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CF12N250/">
    <skos:definition xml:lang="en">Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for dimethyl sulfide is (CH3)2S.  Dimethyl sulfide is sometimes referred to as DMS.</skos:definition>
    <dcterms:identifier>SDN:P07::CF12N250</dcterms:identifier>
    <skos:note xml:lang="en">accepted</skos:note>
    <dc:identifier>SDN:P07::CF12N250</dc:identifier>
    <dcterms:date>2009-07-06 15:41:29.0</dcterms:date>
