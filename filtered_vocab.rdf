    <dcterms:identifier>SDN:P07::CFSN0529</dcterms:identifier>
    <skos:definition xml:lang="en">Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.</skos:definition>
    <ns1:version>1</ns1:version>
    <dc:identifier>SDN:P07::CFSN0529</dc:identifier>
    <dcterms:date>2006-09-26 18:12:43.0</dcterms:date>
    <skos:notation>SDN:P07::CFSN0529</skos:notation>
