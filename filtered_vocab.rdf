    <ns1:authoredOn>2015-01-07 16:23:38.0</ns1:authoredOn>
    <dcterms:identifier>SDN:P07::UBNDM2MJ</dcterms:identifier>
    <dc:identifier>SDN:P07::UBNDM2MJ</dc:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/YIZJ5GAI/">
    <owl:versionInfo>1</owl:versionInfo>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/YIZJ5GAI/1/"/>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
    <skos:definition xml:lang="en">The phrase "integral_wrt_X_of_Y" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase "wrt" means "with respect to". "Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium.</skos:definition>
    <dcterms:identifier>SDN:P07::YIZJ5GAI</dcterms:identifier>
    <dc:identifier>SDN:P07::YIZJ5GAI</dc:identifier>
