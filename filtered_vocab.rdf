  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CF12N457/">
    <ns1:authoredOn>2009-07-06 15:41:29.0</ns1:authoredOn>
    <ns1:version>1</ns1:version>
    <skos:definition xml:lang="en">Mole concentration means number of moles per unit volume, also called "molarity", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for formic acid is HCOOH.  The IUPAC name for formic acid is methanoic acid.</skos:definition>
    <owl:versionInfo>1</owl:versionInfo>
    <skos:altLabel></skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <skos:prefLabel xml:lang="en">mole_concentration_of_formic_acid_in_air</skos:prefLabel>
