    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">The phrase "integral_wrt_X_of_Y" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase "wrt" means "with respect to". "Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Ba" means the element "barium" and "140Ba" is the isotope "barium-140" with a half-life of 1.28e+01 days.</skos:definition>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/A8LKMXA5/1/"/>
