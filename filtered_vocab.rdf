    <owl:versionInfo>2</owl:versionInfo>
    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:identifier>SDN:P07::CF12N240</dcterms:identifier>
    <dc:identifier>SDN:P07::CF12N240</dc:identifier>
    <skos:notation>SDN:P07::CF12N240</skos:notation>
    <dcterms:date>2019-05-14 17:27:19.0</dcterms:date>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/SOMDN03W/">
    <ns1:version>1</ns1:version>
    <dcterms:identifier>SDN:P07::SOMDN03W</dcterms:identifier>
    <dc:identifier>SDN:P07::SOMDN03W</dc:identifier>
