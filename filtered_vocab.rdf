    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <dc:identifier>SDN:P07::QGUDYNG8</dc:identifier>
    <skos:altLabel></skos:altLabel>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/QGUDYNG8/1/"/>
