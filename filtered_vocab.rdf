    <ns1:version>1</ns1:version>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Pr" means the element "praseodymium" and "142mPr" is the metastable state of the isotope "praseodymium-142" with a half-life of 1.01e-02 days.</skos:definition>
    <dc:identifier>SDN:P07::YX0IMWLX</dc:identifier>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:note xml:lang="en">accepted</skos:note>
