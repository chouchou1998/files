  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0369/">
    <skos:altLabel></skos:altLabel>
    <skos:definition xml:lang="en">"Thickness" means the vertical extent of a layer. "Sea ice" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs.</skos:definition>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0369/2/"/>
    <owl:versionInfo>2</owl:versionInfo>
    <skos:note xml:lang="en">accepted</skos:note>
    <ns1:authoredOn>2018-07-03 16:09:23.0</ns1:authoredOn>
    <dcterms:identifier>SDN:P07::CFSN0369</dcterms:identifier>
    <dc:identifier>SDN:P07::CFSN0369</dc:identifier>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0369/1/"/>
