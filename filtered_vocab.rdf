    <skos:altLabel></skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:identifier>SDN:P07::K84MJZZC</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/BMO7V8TT/">
    <owl:versionInfo>1</owl:versionInfo>
    <ns1:version>1</ns1:version>
    <skos:prefLabel xml:lang="en">integral_wrt_time_of_radioactivity_concentration_of_102Mo_in_air</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <dcterms:identifier>SDN:P07::BMO7V8TT</dcterms:identifier>
