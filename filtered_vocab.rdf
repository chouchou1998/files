    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <skos:note xml:lang="en">accepted</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/ATNMCAHQ/">
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
    <skos:prefLabel xml:lang="en">integral_wrt_time_of_radioactivity_concentration_of_252Cf_in_air</skos:prefLabel>
    <skos:definition xml:lang="en">The phrase "integral_wrt_X_of_Y" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase "wrt" means "with respect to". "Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Cf" means the element "californium" and "252Cf" is the isotope "californium-252" with a half-life of 9.68e+02 days.</skos:definition>
    <dcterms:identifier>SDN:P07::ATNMCAHQ</dcterms:identifier>
    <ns1:version>1</ns1:version>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/ATNMCAHQ/1/"/>
    <dc:identifier>SDN:P07::ATNMCAHQ</dc:identifier>
    <skos:notation>SDN:P07::ATNMCAHQ</skos:notation>
    <owl:versionInfo>1</owl:versionInfo>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/UBNDM2MJ/">
    <ns1:version>2</ns1:version>
    <skos:altLabel></skos:altLabel>
    <skos:notation>SDN:P07::UBNDM2MJ</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <skos:definition xml:lang="en">Mole fraction is used in the construction "mole_fraction_of_X_in_Y", where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as "nitrogen" or a phrase such as "nox_expressed_as_nitrogen". The chemical formula for acetaldehyde is CH3CHO. The IUPAC name for acetaldehyde is ethanal.</skos:definition>
    <skos:note xml:lang="en">accepted</skos:note>
    <skos:prefLabel xml:lang="en">mole_fraction_of_acetaldehyde_in_air</skos:prefLabel>
    <owl:versionInfo>2</owl:versionInfo>
    <dcterms:date>2015-01-07 16:23:38.0</dcterms:date>
