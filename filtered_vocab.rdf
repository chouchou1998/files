    <owl:versionInfo>1</owl:versionInfo>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
    <skos:prefLabel xml:lang="en">surface_radioactivity_content_of_127mTe</skos:prefLabel>
    <dcterms:identifier>SDN:P07::UYLGXAPN</dcterms:identifier>
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Te" means the element "tellurium" and "127mTe" is the metastable state of the isotope "tellurium-127" with a half-life of 1.09e+02 days.</skos:definition>
    <dc:identifier>SDN:P07::UYLGXAPN</dc:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/YUR5UUHC/">
