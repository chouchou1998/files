    <owl:deprecated>false</owl:deprecated>
    <dc:identifier>SDN:P07::CFV15A11</dc:identifier>
    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:replaces rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0340/"/>
    <owl:versionInfo>2</owl:versionInfo>
