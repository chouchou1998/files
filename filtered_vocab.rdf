  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/3H8T3GRY/">
    <ns1:version>1</ns1:version>
    <dcterms:date>2016-04-05 15:08:52.0</dcterms:date>
    <dcterms:identifier>SDN:P07::3H8T3GRY</dcterms:identifier>
    <owl:versionInfo>1</owl:versionInfo>
