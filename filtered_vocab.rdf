    <skos:note xml:lang="en">accepted</skos:note>
    <skos:notation>SDN:P07::N5HDC6DX</skos:notation>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/N5HDC6DX/1/"/>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_113mAg_in_air</skos:prefLabel>
    <ns1:version>1</ns1:version>
  </rdf:Description>
