    <dcterms:isReplacedBy rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12S19/"/>
    <skos:note xml:lang="en">deprecated</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/GLTJW0KA/">
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/GLTJW0KA/1/"/>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Tl" means the element "thallium" and "209Tl" is the isotope "thallium-209" with a half-life of 1.53e-03 days.</skos:definition>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
