    <skos:note xml:lang="en">accepted</skos:note>
    <skos:altLabel></skos:altLabel>
    <dcterms:identifier>SDN:P07::CF12N500</dcterms:identifier>
    <dc:identifier>SDN:P07::CF12N500</dc:identifier>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12N500/1/"/>
    <skos:notation>SDN:P07::CF12N500</skos:notation>
    <dcterms:date>2019-02-04 14:52:10.0</dcterms:date>
    <ns1:authoredOn>2019-02-04 14:52:10.0</ns1:authoredOn>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">mole_concentration_of_peroxyacetyl_nitrate_in_air</skos:prefLabel>
    <skos:definition xml:lang="en">"Mole concentration" means number of moles per unit volume, also called "molarity", and is used in the construction "mole_concentration_of_X_in_Y", where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as "nitrogen" or a phrase such as "nox_expressed_as_nitrogen". The chemical formula for peroxyacetyl nitrate, sometimes referred to as PAN, is CH3COO2NO2.  The IUPAC name for peroxyacetyl nitrate is nitroethaneperoxoate.</skos:definition>
    <owl:deprecated>false</owl:deprecated>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/919O9Z29/">
    <ns1:authoredOn>2022-03-18 12:42:55.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
    <skos:definition xml:lang="en">"Mole concentration" means number of moles per unit volume, also called "molarity", and is used in the construction "mole_concentration_of_X_in_Y", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as "nitrogen" or a phrase such as "nox_expressed_as_nitrogen". Phosphorus means phosphorus in all chemical forms, commonly referred to as "total phosphorus". The equivalent term in the NERC P01 Parameter Usage Vocabulary may be found at http://vocab.nerc.ac.uk/collection/P01/current/TPHSDSZZ/6/.</skos:definition>
    <dcterms:identifier>SDN:P07::919O9Z29</dcterms:identifier>
    <dc:identifier>SDN:P07::919O9Z29</dc:identifier>
