    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dcterms:identifier>SDN:P07::YXE1NWAO</dcterms:identifier>
    <owl:deprecated>false</owl:deprecated>
    <dc:identifier>SDN:P07::YXE1NWAO</dc:identifier>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:prefLabel xml:lang="en">integral_wrt_time_of_radioactivity_concentration_of_87Rb_in_air</skos:prefLabel>
    <skos:altLabel></skos:altLabel>
    <skos:notation>SDN:P07::YXE1NWAO</skos:notation>
    <skos:definition xml:lang="en">The phrase "integral_wrt_X_of_Y" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase "wrt" means "with respect to". "Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Rb" means the element "rubidium" and "87Rb" is the isotope "rubidium-87" with a half-life of 1.71e+13 days.</skos:definition>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/YXE1NWAO/1/"/>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
