    <skos:notation>SDN:P07::2ZH3B48P</skos:notation>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Xe" means the element "xenon" and "134mXe" is the metastable state of the isotope "xenon-134" with a half-life of 3.36e-06 days.</skos:definition>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_134mXe_in_air</skos:prefLabel>
    <ns1:version>1</ns1:version>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/AIATEZMN/">
    <owl:versionInfo>1</owl:versionInfo>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/AIATEZMN/1/"/>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Pb" means the element "lead" and "209Pb" is the isotope "lead-209" with a half-life of 1.38e-01 days.</skos:definition>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
