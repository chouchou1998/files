    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <dc:identifier>SDN:P07::U6CGJGJG</dc:identifier>
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "In" means the element "indium" and "117mIn" is the metastable state of the isotope "indium-117" with a half-life of 8.08e-02 days.</skos:definition>
    <skos:prefLabel xml:lang="en">surface_radioactivity_content_of_117mIn</skos:prefLabel>
    <skos:notation>SDN:P07::U6CGJGJG</skos:notation>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/U6CGJGJG/1/"/>
