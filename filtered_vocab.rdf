    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <skos:notation>SDN:P07::NLFOFQF4</skos:notation>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <dc:identifier>SDN:P07::NLFOFQF4</dc:identifier>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_109mAg_in_air</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CF12N317/">
    <dcterms:identifier>SDN:P07::CF12N317</dcterms:identifier>
    <owl:versionInfo>2</owl:versionInfo>
    <dcterms:isReplacedBy rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/WM3WIV44/"/>
    <dcterms:date>2015-01-07 15:23:06.0</dcterms:date>
    <skos:notation>SDN:P07::CF12N317</skos:notation>
    <skos:prefLabel xml:lang="en">mass_concentration_of_secondary_particulate_organic_matter_dry_aerosol_in_air</skos:prefLabel>
    <skos:definition xml:lang="en">Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. "Aerosol" means the suspended liquid or solid particles in air (except cloud droplets).  Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. "Dry aerosol" means aerosol without water. "Secondary particulate organic matter " means particulate organic matter formed within the atmosphere from gaseous precursors. The sum of primary_particulate_organic_matter_dry_aerosol and secondary_particulate_organic_matter_dry_aerosol is particulate_organic_matter_dry_aerosol.</skos:definition>
    <ns1:authoredOn>2015-01-07 15:23:06.0</ns1:authoredOn>
    <dc:identifier>SDN:P07::CF12N317</dc:identifier>
    <owl:deprecated>true</owl:deprecated>
    <skos:note xml:lang="en">deprecated</skos:note>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12N317/2/"/>
    <ns1:version>2</ns1:version>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12N317/1/"/>
    <skos:altLabel></skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/0YFCOD6R/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <dcterms:identifier>SDN:P07::0YFCOD6R</dcterms:identifier>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/0YFCOD6R/1/"/>
    <dc:identifier>SDN:P07::0YFCOD6R</dc:identifier>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "In" means the element "indium" and "117mIn" is the metastable state of the isotope "indium-117" with a half-life of 8.08e-02 days.</skos:definition>
    <skos:altLabel></skos:altLabel>
    <skos:notation>SDN:P07::0YFCOD6R</skos:notation>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_117mIn_in_air</skos:prefLabel>
    <owl:versionInfo>1</owl:versionInfo>
    <ns1:version>1</ns1:version>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/F4SYKX2M/">
    <skos:prefLabel xml:lang="en">flood_water_thickness</skos:prefLabel>
    <owl:versionInfo>1</owl:versionInfo>
    <ns1:version>1</ns1:version>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <dcterms:identifier>SDN:P07::F4SYKX2M</dcterms:identifier>
    <dc:identifier>SDN:P07::F4SYKX2M</dc:identifier>
    <dcterms:date>2016-05-17 15:31:00.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <skos:notation>SDN:P07::F4SYKX2M</skos:notation>
    <skos:definition xml:lang="en">The flood_water_thickness is the vertical distance between the surface of the flood water and the surface of the solid ground, as measured at a given point in space. The standard name ground_level_altitude is used for a data variable giving the geometric height of the ground surface above the geoid. "Flood water" is water that covers land which is normally not covered by water.</skos:definition>
    <ns1:authoredOn>2016-05-17 15:31:00.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/F4SYKX2M/1/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0646/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0646/1/"/>
    <dcterms:date>2006-09-26 18:12:43.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <ns1:authoredOn>2006-09-26 18:12:43.0</ns1:authoredOn>
    <skos:definition xml:lang="en">'Eastward' indicates a vector component which is positive when directed eastward (negative westward). Transport across_unit_distance means expressed per unit distance normal to the direction of transport.</skos:definition>
    <dcterms:identifier>SDN:P07::CFSN0646</dcterms:identifier>
    <skos:note xml:lang="en">accepted</skos:note>
    <dc:identifier>SDN:P07::CFSN0646</dc:identifier>
    <skos:notation>SDN:P07::CFSN0646</skos:notation>
    <skos:prefLabel xml:lang="en">eastward_atmosphere_water_vapor_transport_across_unit_distance</skos:prefLabel>
    <owl:versionInfo>1</owl:versionInfo>
    <ns1:version>1</ns1:version>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CF12N283/">
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12N283/2/"/>
    <skos:notation>SDN:P07::CF12N283</skos:notation>
    <ns1:authoredOn>2015-01-07 15:23:06.0</ns1:authoredOn>
    <owl:deprecated>true</owl:deprecated>
    <skos:note xml:lang="en">deprecated</skos:note>
    <ns1:version>2</ns1:version>
    <skos:altLabel></skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dcterms:isReplacedBy rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/PCDEL2PW/"/>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12N283/1/"/>
    <owl:versionInfo>2</owl:versionInfo>
    <skos:definition xml:lang="en">Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. "Aerosol" means the suspended liquid or solid particles in air (except cloud droplets).  Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. "Dry aerosol" means aerosol without water.</skos:definition>
    <skos:prefLabel xml:lang="en">mass_concentration_of_mercury_dry_aerosol_in_air</skos:prefLabel>
    <dcterms:date>2015-01-07 15:23:06.0</dcterms:date>
