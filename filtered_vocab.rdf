    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/3YPXA7VJ/1/"/>
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Rh" means the element "rhodium" and "107Rh" is the isotope "rhodium-107" with a half-life of 1.51e-02 days.</skos:definition>
    <skos:altLabel></skos:altLabel>
