    <skos:prefLabel xml:lang="en">surface_radioactivity_content_of_115In</skos:prefLabel>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/YVCZHRK1/1/"/>
    <skos:note xml:lang="en">accepted</skos:note>
