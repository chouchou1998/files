    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <skos:notation>SDN:P07::CFSN0452</skos:notation>
    <dc:identifier>SDN:P07::CFSN0452</dc:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0338/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:note xml:lang="en">deprecated</skos:note>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0338/1/"/>
