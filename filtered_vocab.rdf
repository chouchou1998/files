  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/NK7W2T5M/">
    <skos:prefLabel xml:lang="en">sea_binary_mask</skos:prefLabel>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/NK7W2T5M/1/"/>
    <owl:versionInfo>1</owl:versionInfo>
    <ns1:version>1</ns1:version>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dcterms:identifier>SDN:P07::NK7W2T5M</dcterms:identifier>
    <skos:definition xml:lang="en">X"_binary_mask" has 1 where condition X is met, 0 elsewhere. 1 = sea, 0 = land.</skos:definition>
    <dc:identifier>SDN:P07::NK7W2T5M</dc:identifier>
    <dcterms:date>2018-04-16 15:20:49.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
