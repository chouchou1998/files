    <skos:note xml:lang="en">accepted</skos:note>
    <owl:versionInfo>1</owl:versionInfo>
    <ns1:version>1</ns1:version>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Ra" means the element "radium" and "226Ra" is the isotope "radium-226" with a half-life of 5.86e+05 days.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/BNDR0RHQ/">
    <skos:note xml:lang="en">accepted</skos:note>
