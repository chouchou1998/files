    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/B6RNUI5Q/1/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/Q484Y0FK/">
    <skos:note xml:lang="en">accepted</skos:note>
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Xe" means the element "xenon" and "133Xe" is the isotope "xenon-133" with a half-life of 5.28e+00 days.</skos:definition>
    <dcterms:identifier>SDN:P07::Q484Y0FK</dcterms:identifier>
    <dc:identifier>SDN:P07::Q484Y0FK</dc:identifier>
    <ns1:version>1</ns1:version>
    <skos:notation>SDN:P07::Q484Y0FK</skos:notation>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/Q484Y0FK/1/"/>
    <owl:versionInfo>1</owl:versionInfo>
    <skos:prefLabel xml:lang="en">surface_radioactivity_content_of_133Xe</skos:prefLabel>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
