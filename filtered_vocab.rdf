    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/80SFD1ZQ/1/"/>
  </rdf:Description>
