  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/LIQFVQYM/">
    <ns1:version>1</ns1:version>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_137mBa_in_air</skos:prefLabel>
    <owl:versionInfo>1</owl:versionInfo>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Ba" means the element "barium" and "137mBa" is the metastable state of the isotope "barium-137" with a half-life of 1.77e-03 days.</skos:definition>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
