  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/JECE7X85/">
    <skos:prefLabel xml:lang="en">integral_wrt_time_of_radioactivity_concentration_of_144Pr_in_air</skos:prefLabel>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/JECE7X85/1/"/>
    <ns1:version>1</ns1:version>
    <dcterms:identifier>SDN:P07::JECE7X85</dcterms:identifier>
