    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_102mTc_in_air</skos:prefLabel>
    <skos:note xml:lang="en">accepted</skos:note>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/FSFO1AH5/1/"/>
