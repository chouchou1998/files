    <skos:altLabel></skos:altLabel>
    <skos:notation>SDN:P07::YQUEEUJE</skos:notation>
    <skos:definition xml:lang="en">"y" indicates a vector component along the grid y-axis, positive with increasing y.</skos:definition>
    <skos:prefLabel xml:lang="en">ocean_volume_y_transport</skos:prefLabel>
    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:date>2013-03-23 09:22:59.0</dcterms:date>
