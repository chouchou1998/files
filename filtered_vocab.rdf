    <owl:versionInfo>1</owl:versionInfo>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CFV7N47/">
    <ns1:version>1</ns1:version>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFV7N47/1/"/>
