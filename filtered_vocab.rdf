    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/HVJP174E/1/"/>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Cm" means the element "curium" and "245Cm" is the isotope "curium-245" with a half-life of 3.40e+06 days.</skos:definition>
    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <dcterms:identifier>SDN:P07::HVJP174E</dcterms:identifier>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_245Cm_in_air</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0516/">
    <skos:definition xml:lang="en">moles_of_X_per_unit_mass_inY is also called 'molality' of X in Y, where X is a material constituent of Y.</skos:definition>
