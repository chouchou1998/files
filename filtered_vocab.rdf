  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/D22YYKEJ/">
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <skos:note xml:lang="en">accepted</skos:note>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <dcterms:identifier>SDN:P07::D22YYKEJ</dcterms:identifier>
    <ns1:version>1</ns1:version>
    <dc:identifier>SDN:P07::D22YYKEJ</dc:identifier>
    <skos:prefLabel xml:lang="en">surface_radioactivity_content_of_152Pm</skos:prefLabel>
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Pm" means the element "promethium" and "152Pm" is the isotope "promethium-152" with a half-life of 2.84e-03 days.</skos:definition>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/D22YYKEJ/1/"/>
    <skos:notation>SDN:P07::D22YYKEJ</skos:notation>
    <owl:versionInfo>1</owl:versionInfo>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CFV15A30/">
    <skos:prefLabel xml:lang="en">thermal_energy_content_of_surface_snow</skos:prefLabel>
    <ns1:authoredOn>2021-01-18 16:23:44.0</ns1:authoredOn>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:version>2</ns1:version>
    <owl:deprecated>false</owl:deprecated>
    <owl:sameAs rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0342/"/>
    <owl:versionInfo>2</owl:versionInfo>
    <skos:definition xml:lang="en">"Content" indicates a quantity per unit area. Thermal energy is the total vibrational energy, kinetic and potential, of all the molecules and atoms in a substance. Surface snow refers to the snow on the solid ground or on surface ice cover, but excludes, for example, falling snowflakes and snow on plants.</skos:definition>
    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:identifier>SDN:P07::CFV15A30</dcterms:identifier>
    <skos:altLabel></skos:altLabel>
    <dcterms:replaces rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0342/"/>
    <skos:notation>SDN:P07::CFV15A30</skos:notation>
    <dc:identifier>SDN:P07::CFV15A30</dc:identifier>
    <dcterms:date>2021-01-18 16:23:44.0</dcterms:date>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFV15A30/1/"/>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFV15A30/2/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/ZIQR6M5K/">
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Pr" means the element "praseodymium" and "146Pr" is the isotope "praseodymium-146" with a half-life of 1.68e-02 days.</skos:definition>
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:identifier>SDN:P07::ZIQR6M5K</dcterms:identifier>
