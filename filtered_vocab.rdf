    <ns1:version>2</ns1:version>
    <dcterms:date>2018-07-03 16:09:23.0</dcterms:date>
    <owl:deprecated>false</owl:deprecated>
    <skos:prefLabel xml:lang="en">sea_ice_thickness</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/F7ULFK7I/">
    <ns1:version>1</ns1:version>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The phrase "integral_wrt_X_of_Y" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase "wrt" means "with respect to". "Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Eu" means the element "europium" and "159Eu" is the isotope "europium-159" with a half-life of 1.26e-02 days.</skos:definition>
    <owl:deprecated>false</owl:deprecated>
    <skos:prefLabel xml:lang="en">integral_wrt_time_of_radioactivity_concentration_of_159Eu_in_air</skos:prefLabel>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
