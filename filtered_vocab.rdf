    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:definition xml:lang="en">The phrase "integral_wrt_X_of_Y" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase "wrt" means "with respect to". "Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Pu" means the element "plutonium" and "238Pu" is the isotope "plutonium-238" with a half-life of 3.15e+04 days.</skos:definition>
    <skos:note xml:lang="en">accepted</skos:note>
    <dcterms:identifier>SDN:P07::WFUQMU6R</dcterms:identifier>
    <ns1:version>1</ns1:version>
    <skos:prefLabel xml:lang="en">integral_wrt_time_of_radioactivity_concentration_of_238Pu_in_air</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/Z1933MWF/">
