    <dcterms:identifier>SDN:P07::31IY1T9C</dcterms:identifier>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Hg" means the element "mercury" and "206Hg" is the isotope "mercury-206" with a half-life of 5.57e-03 days.</skos:definition>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_206Hg_in_air</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0255/">
    <skos:definition xml:lang="en">Surface snow refers to the snow on the solid ground or on surface ice cover, but excludes, for example, falling snowflakes and snow on plants. The snow melt heat flux is the supply of latent heat which is melting snow at freezing point. In accordance with common usage in geophysical disciplines, "flux" implies per unit area, called "flux density" in physics.</skos:definition>
    <skos:notation>SDN:P07::CFSN0255</skos:notation>
    <dcterms:date>2021-01-18 16:23:44.0</dcterms:date>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0255/2/"/>
    <ns1:authoredOn>2021-01-18 16:23:44.0</ns1:authoredOn>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:deprecated>false</owl:deprecated>
    <owl:versionInfo>2</owl:versionInfo>
    <skos:note xml:lang="en">accepted</skos:note>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0255/1/"/>
    <ns1:version>2</ns1:version>
    <skos:altLabel></skos:altLabel>
    <dcterms:identifier>SDN:P07::CFSN0255</dcterms:identifier>
    <dc:identifier>SDN:P07::CFSN0255</dc:identifier>
    <skos:prefLabel xml:lang="en">surface_snow_melt_heat_flux</skos:prefLabel>
  </rdf:Description>
