  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/62CID062/">
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/62CID062/1/"/>
    <dcterms:identifier>SDN:P07::62CID062</dcterms:identifier>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
    <skos:prefLabel xml:lang="en">surface_radioactivity_content_of_158Eu</skos:prefLabel>
    <skos:note xml:lang="en">accepted</skos:note>
    <dc:identifier>SDN:P07::62CID062</dc:identifier>
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Eu" means the element "europium" and "158Eu" is the isotope "europium-158" with a half-life of 3.18e-02 days.</skos:definition>
    <skos:notation>SDN:P07::62CID062</skos:notation>
    <ns1:version>1</ns1:version>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:versionInfo>1</owl:versionInfo>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0560/">
