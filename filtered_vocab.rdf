    <dc:identifier>SDN:P07::FK6NPY5L</dc:identifier>
    <ns1:authoredOn>2023-07-05 16:51:32.0</ns1:authoredOn>
    <skos:notation>SDN:P07::FK6NPY5L</skos:notation>
    <owl:deprecated>true</owl:deprecated>
    <skos:prefLabel xml:lang="en">universal_thermal_climate_index</skos:prefLabel>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/FK6NPY5L/1/"/>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/FK6NPY5L/2/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/9DJWC2S1/">
    <skos:definition xml:lang="en">The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Sm" means the element "samarium" and "156Sm" is the isotope "samarium-156" with a half-life of 3.91e-01 days.</skos:definition>
    <skos:notation>SDN:P07::9DJWC2S1</skos:notation>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
