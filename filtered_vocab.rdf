    <skos:notation>SDN:P07::CID3G78W</skos:notation>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Pd" means the element "palladium" and "112Pd" is the isotope "palladium-112" with a half-life of 8.37e-01 days.</skos:definition>
    <owl:versionInfo>1</owl:versionInfo>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_112Pd_in_air</skos:prefLabel>
    <skos:note xml:lang="en">accepted</skos:note>
    <ns1:authoredOn>2018-02-12 16:53:18.0</ns1:authoredOn>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/11HZCKVD/">
    <dcterms:identifier>SDN:P07::11HZCKVD</dcterms:identifier>
    <dc:identifier>SDN:P07::11HZCKVD</dc:identifier>
    <owl:versionInfo>1</owl:versionInfo>
    <skos:notation>SDN:P07::11HZCKVD</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
