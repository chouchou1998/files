    <ns1:version>1</ns1:version>
    <dc:identifier>SDN:P07::6ZA46UTH</dc:identifier>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Po" means the element "polonium" and "213Po" is the isotope "polonium-213" with a half-life of 4.86e-11 days.</skos:definition>
    <skos:notation>SDN:P07::6ZA46UTH</skos:notation>
    <owl:versionInfo>1</owl:versionInfo>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_213Po_in_air</skos:prefLabel>
