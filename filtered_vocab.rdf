  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CF12N162/">
    <skos:note xml:lang="en">accepted</skos:note>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12N162/2/"/>
    <skos:definition xml:lang="en">The construction "atmosphere_moles_of_X" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. In chemistry, a "radical" is a highly reactive, and therefore short lived, species.</skos:definition>
    <dcterms:identifier>SDN:P07::CF12N162</dcterms:identifier>
    <dc:identifier>SDN:P07::CF12N162</dc:identifier>
    <dcterms:date>2019-03-04 17:29:46.0</dcterms:date>
    <skos:notation>SDN:P07::CF12N162</skos:notation>
    <ns1:version>2</ns1:version>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">atmosphere_moles_of_nitrate_radical</skos:prefLabel>
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12N162/1/"/>
    <ns1:authoredOn>2019-03-04 17:29:46.0</ns1:authoredOn>
    <owl:versionInfo>2</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/YXE1NWAO/">
