    <dcterms:identifier>SDN:P07::PTKPZ95L</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/6ZA46UTH/">
    <skos:altLabel></skos:altLabel>
    <owl:deprecated>false</owl:deprecated>
