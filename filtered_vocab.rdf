    <skos:notation>SDN:P07::FPNGM6MF</skos:notation>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_113mIn_in_air</skos:prefLabel>
    <skos:note xml:lang="en">accepted</skos:note>
  </rdf:Description>
