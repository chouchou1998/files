  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/H21L8QYO/">
    <dcterms:identifier>SDN:P07::H21L8QYO</dcterms:identifier>
    <skos:definition xml:lang="en">"Radioactivity" means the number of radioactive decays of a material per second. "Radioactivity concentration" means radioactivity per unit volume of the medium. "Pu" means the element "plutonium" and "244Pu" is the isotope "plutonium-244" with a half-life of 2.92e+10 days.</skos:definition>
    <ns1:version>1</ns1:version>
    <skos:prefLabel xml:lang="en">radioactivity_concentration_of_244Pu_in_air</skos:prefLabel>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/H21L8QYO/1/"/>
    <dc:identifier>SDN:P07::H21L8QYO</dc:identifier>
