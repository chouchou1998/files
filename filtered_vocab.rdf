  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/I93Q99NX/">
    <skos:notation>SDN:P07::I93Q99NX</skos:notation>
    <owl:versionInfo>1</owl:versionInfo>
    <dcterms:date>2018-02-12 16:53:18.0</dcterms:date>
