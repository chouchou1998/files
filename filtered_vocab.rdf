  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/CF12S21/">
    <owl:sameAs rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0705/"/>
    <owl:sameAs rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSNA003/"/>
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12S21/2/"/>
    <dcterms:date>2013-11-08 14:08:48.0</dcterms:date>
    <dcterms:identifier>SDN:P07::CF12S21</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dc:identifier>SDN:P07::CF12S21</dc:identifier>
    <dcterms:replaces rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSN0705/"/>
    <dcterms:replaces rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CFSNA003/"/>
    <skos:definition xml:lang="en">Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as "nitrogen" or a phrase such as "nox_expressed_as_nitrogen". Chlorophylls are the green pigments found in most plants, algae and cyanobacteria; their presence is essential for photosynthesis to take place. There are several different forms of chlorophyll that occur naturally. All contain a chlorin ring (chemical formula C20H16N4) which gives the green pigment and a side chain whose structure varies. The naturally occurring forms of chlorophyll contain between 35 and 55 carbon atoms.</skos:definition>
    <ns1:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/CF12S21/1/"/>
    <owl:deprecated>false</owl:deprecated>
    <ns1:authoredOn>2013-11-08 14:08:48.0</ns1:authoredOn>
    <skos:notation>SDN:P07::CF12S21</skos:notation>
    <skos:note xml:lang="en">accepted</skos:note>
    <owl:versionInfo>2</owl:versionInfo>
    <ns1:version>2</ns1:version>
    <skos:altLabel></skos:altLabel>
    <skos:prefLabel xml:lang="en">mass_concentration_of_chlorophyll_in_sea_water</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P07/current/H165X1BD/">
    <ns1:hasCurrentVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P07/current/H165X1BD/1/"/>
    <owl:versionInfo>1</owl:versionInfo>
    <ns1:version>1</ns1:version>
